{
  "name": "nyx-electron",
  "productName": "Nyx",
  "version": "0.2.0",
  "description": "Nyx browser — fast, private, yours",
  "main": "out/main/index.js",
  "author": "Joel Lewis",
  "private": true,
  "nyxUpdateRepo": "tigercommander131/nyx-browser",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-vite build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.nyx.electron",
    "productName": "Nyx",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "identity": null,
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web URLs",
            "CFBundleURLSchemes": ["http", "https"]
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": ["public.html", "public.xhtml"]
          }
        ],
        "NSCameraUsageDescription": "Sites you allow can use the camera.",
        "NSMicrophoneUsageDescription": "Sites you allow can use the microphone.",
        "NSLocationWhenInUseUsageDescription": "Sites you allow can see your location."
      },
      "target": [
        {
          "target": "dmg"
        }
      ]
    },
    "dmg": {
      "title": "Nyx"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.1",
    "better-sqlite3": "^13.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "ws": "^8.21.1"
  }
}
